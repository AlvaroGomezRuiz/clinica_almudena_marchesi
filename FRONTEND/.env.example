# ============================================================================
# FRONTEND/.env.example  —  Copiar a .env.local y rellenar
# ============================================================================
# NUNCA commitear .env.local ni ningún secreto real.
# Las keys public (anon) son seguras para el browser bajo RLS activo.
# La service_role key es EXCLUSIVA backend y rota ante sospecha.
# ============================================================================

# --- API backend (FastAPI refactored) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000/api/v1

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Recomendado: key publishable `sb_publishable_...` (mejor rotación).
# Compatible: legacy anon JWT (solo si tu tooling lo requiere).
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sb_publishable_or_anon_jwt>

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Observabilidad ---
NEXT_PUBLIC_SENTRY_DSN=

# --- Entorno ---
NEXT_PUBLIC_APP_ENV=development
