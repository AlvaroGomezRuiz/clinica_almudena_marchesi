{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",

  "regions": ["fra1"],

  "functions": {
    "src/app/api/**/*.{ts,tsx}": {
      "maxDuration": 15,
      "memory": 512
    },
    "src/app/api/portal/factura/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "src/app/api/admin/facturacion/export/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },

  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://ampsicologia.es"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/image",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        }
      ]
    }
  ]
}
