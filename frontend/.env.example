# ============================================================================
# frontend/.env.example  —  Copiar a .env.local y rellenar
# ============================================================================
# NUNCA commitear .env.local ni ningún secreto real.
# Las keys public (anon) son seguras para el browser bajo RLS activo.
# La service_role key es EXCLUSIVA backend y rota ante sospecha.
# ============================================================================

# --- API backend (FastAPI refactored) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000/api/v1

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Recomendado: key publishable `sb_publishable_...` (mejor rotación).
# Compatible: legacy anon JWT (solo si tu tooling lo requiere).
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sb_publishable_or_anon_jwt>

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Observabilidad (Sentry) ---
# DSN del proyecto Sentry (región EU obligatoria — datos sanitarios RGPD).
# Ej: https://xxx@oXXX.ingest.de.sentry.io/YYY
NEXT_PUBLIC_SENTRY_DSN=
# Opcional: si está definido y hay AUTH_TOKEN, se suben source maps en build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Token aleatorio para la ruta /sentry-check (evita que crawlers disparen eventos)
SENTRY_CHECK_TOKEN=

# --- Entorno ---
NEXT_PUBLIC_APP_ENV=development
