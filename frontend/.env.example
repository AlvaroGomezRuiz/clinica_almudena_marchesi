# ============================================================================
# frontend/.env.example  —  copiar a .env.local y rellenar
# ============================================================================
# NUNCA commitear .env.local ni ningun secreto real.
# Las keys public (anon / publishable) son seguras para el browser bajo RLS.
# La service_role key es EXCLUSIVA backend y rota ante cualquier sospecha.
# ============================================================================

# --- Entorno ---
# development | preview | production
NEXT_PUBLIC_APP_ENV=development

# --- URLs canonicas ---
# Vercel production apuntara al dominio definitivo; hasta DNS puede usarse el preview.
# Alinear con FRONTEND_URL en Supabase Edge Secrets y con los redirect URLs de Auth.
NEXT_PUBLIC_APP_URL=https://amclinicapsicologia.es
NEXT_PUBLIC_SITE_URL=https://amclinicapsicologia.es

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Recomendado: publishable key `sb_publishable_...` (mejor rotacion).
# Compatible: legacy anon JWT si el tooling lo requiere.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sb_publishable_or_anon_jwt>

# --- Supabase (server-only) ---
# Solo usada por rutas server-side de confianza (/api/admin/*, webhooks).
# NUNCA prefijar con NEXT_PUBLIC_. No se expone al browser.
SUPABASE_SERVICE_ROLE_KEY=<service_role_jwt>

# --- Stripe ---
# Publishable (browser): ok exponer
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Secret (server-only): si alguna ruta /api/stripe/* la usa directamente.
# El webhook principal vive en Supabase Edge Function `stripe-webhook`.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Observabilidad (Sentry) ---
# DSN del proyecto Sentry (region EU obligatoria -- datos sanitarios RGPD).
# Ej: https://xxx@oXXX.ingest.de.sentry.io/YYY
NEXT_PUBLIC_SENTRY_DSN=
# Opcional: si estan definidos, el build sube source maps y las borra del CDN publico.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Token aleatorio para la ruta /api/sentry-check (evita que crawlers disparen eventos).
SENTRY_CHECK_TOKEN=

# --- Cron / Edge Functions ---
# Mismo valor que `CRON_SECRET` en Supabase Edge Secrets.
# Usado cuando el frontend dispara callbacks manuales a `cron-recordatorios-24h`.
CRON_SECRET=

# --- Rate limit distribuido (Upstash Redis) ---
# Opcional: si se definen, `enforceRateLimit` usa sliding-window global
# compartido entre todas las instancias Vercel (hard limit real). Si no se
# definen, cae a un Map per-instance en memoria (mitigacion suave). Ver
# https://upstash.com/docs/redis/features/restapi
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- E2E tests (Playwright) ---
# URL base contra la que correr los tests de Playwright. En CI apunta a un
# preview de Vercel; en local normalmente http://localhost:3000.
PLAYWRIGHT_BASE_URL=http://localhost:3000
# Credenciales de seed demo en STAGING (no usar en produccion real):
PLAYWRIGHT_ADMIN_EMAIL=almudena@admin.com
PLAYWRIGHT_ADMIN_PASSWORD=Almudena2026!
PLAYWRIGHT_PATIENT_EMAIL=usuario@visualizacion.com
PLAYWRIGHT_PATIENT_PASSWORD=Usuario2026!

# ============================================================================
# Notas de despliegue (Vercel · produccion)
# ============================================================================
# - Production Branch (GitHub default): `frontend` (minusculas).
# - Root Directory del proyecto Vercel: `frontend` (minusculas · Linux case-sensitive).
# - Region de ejecucion: `fra1` (Frankfurt) en `vercel.json`, misma que Supabase eu-central-1.
# - Todas las variables anteriores deben existir tambien en Vercel > Project Settings >
#   Environment Variables, diferenciando Preview vs Production si procede.
# ============================================================================
