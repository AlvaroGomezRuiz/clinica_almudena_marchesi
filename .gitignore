# =============================================================================
# .gitignore — Clinica Almudena Marchesi
# Arquitectura: Next.js (frontend) + FastAPI stand-by (backend) + Supabase
# Convencion: todas las rutas en minusculas. Patrones globales con **.
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETOS Y CONFIGURACION LOCAL (CRITICO — NUNCA COMMITEAR)
# -----------------------------------------------------------------------------
**/.env
**/.env.local
**/.env.*.local
!**/.env.example
!**/.env.*.example

# Supabase CLI local state
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/functions/.bundled/

# Llaves y certificados
*.pem
*.crt
*.key
*.pfx
*.p12

# -----------------------------------------------------------------------------
# BACKEND (Python / FastAPI stand-by)
# -----------------------------------------------------------------------------
backend/venv/
backend/.venv/
backend/uploads/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
pip-wheel-metadata/
**/.python-version

# -----------------------------------------------------------------------------
# FRONTEND (Next.js / Node)
# -----------------------------------------------------------------------------
**/node_modules/
**/.next/
**/.turbo/
**/.vercel/
**/out/
**/build/
**/*.tsbuildinfo
**/.swc/
**/.eslintcache
frontend/next-env.d.ts

# Reportes Lighthouse locales
lh-*.json
lh-report*.json
**/lh/

# -----------------------------------------------------------------------------
# DATOS SENSIBLES
# -----------------------------------------------------------------------------
backups/
*.sql
!supabase/migrations/*.sql
!supabase/functions/**/*.sql
*.gz
*.db
*.sqlite
*.sqlite3

# -----------------------------------------------------------------------------
# DOCKER / INFRA
# -----------------------------------------------------------------------------
docker/db_data/
.docker_volumes/

# -----------------------------------------------------------------------------
# LOGS
# -----------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.sentry-debug.log

# -----------------------------------------------------------------------------
# IDE / SISTEMA OPERATIVO
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# HERRAMIENTAS INTERNAS / PROTOTIPOS / ARTEFACTOS PRIVADOS
# -----------------------------------------------------------------------------
.agents/
.cursor/
.cursorignore
.cursorrules
.prototipo/
.geo/
skills-lock.json

# -----------------------------------------------------------------------------
# SCRIPTS LOCALES DE ARRANQUE (desarrollo individual)
# -----------------------------------------------------------------------------
/start_all.bat
/start_all.py
