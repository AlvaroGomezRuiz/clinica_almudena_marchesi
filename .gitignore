# =============================================================================
# .GITIGNORE MAESTRO - CLÍNICA ALMUDENA (BLINDAJE TOTAL)
# =============================================================================

# --- IA ---
.cursorrules
.cursorignore
/cursor
/DOCS
/PROTOTIPO
/.agents

# --- ENTORNO VIRTUAL Y SECRETOS (CRÍTICO) ---
# Nunca subir las llaves del búnker ni las librerías locales.
backend/venv/
BACKEND/venv/
.env
.env.local
.env.*.local


# --- DATOS SENSIBLES Y PRIVACIDAD MÉDICA ---
# Esta información reside exclusivamente en el búnker local o producción.
backend/uploads/
BACKEND/uploads/
backups/
*.sql
*.gz
*.db
*.sqlite3

# --- PYTHON: BASURA TÉCNICA ---
**/__pycache__/
*.pyc
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# --- FRONTEND: NODE / NEXT.JS ---
prototipo/
frontend/node_modules/
FRONTEND/node_modules/
frontend/.next/
FRONTEND/.next/
frontend/out/
FRONTEND/out/
frontend/build/
FRONTEND/build/
.next/
out/
build/
.eslintcache
npm-debug.log*
yarn-debug.log*

# --- REPORTS (Lighthouse, auditorías) ---
FRONTEND/lh-*.json
FRONTEND/lh-report*.json
lh-*.json
lh-report*.json
FRONTEND/lh/

# --- DOCKER Y PERSISTENCIA ---
docker/db_data/
.docker_volumes/

# --- CONFIGURACIÓN DE EDITORES (IDE) ---
# Evita fugas de rutas locales del desarrollador.
.vscode/
.idea/
*.swp
*.sublime-project
*.sublime-workspace

# --- MONITOREO Y DIAGNÓSTICO ---
*.log
.sentry-debug.log

# --- CERTIFICADOS Y LLAVES DE SEGURIDAD ---
# Blindaje contra subida accidental de certificados SSL o llaves RSA.
*.pem
*.crt
*.key
*.pfx

# --- SISTEMA OPERATIVO ---
.DS_Store
Thumbs.db
desktop.ini

# --- MIGRACIONES DE BASE DE DATOS ---
backend/alembic/versions/*.pyc
BACKEND/alembic/versions/*.pyc
