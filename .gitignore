# =============================================================================
# .gitignore — Clinica Almudena Marchesi
# Arquitectura: Next.js (frontend) + Supabase (Postgres + Auth + Storage + Edge Functions)
# Convencion: todas las rutas en minusculas. Patrones globales con **.
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETOS Y CONFIGURACION LOCAL (CRITICO — NUNCA COMMITEAR)
# -----------------------------------------------------------------------------
**/.env
**/.env.local
**/.env.*.local
!**/.env.example
!**/.env.*.example

# Supabase CLI local state
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/functions/.bundled/

# Llaves y certificados
*.pem
*.crt
*.key
*.pfx
*.p12

# -----------------------------------------------------------------------------
# PYTHON (scripts operativos si los hubiera)
# -----------------------------------------------------------------------------
**/venv/
**/.venv/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
pip-wheel-metadata/
**/.python-version

# -----------------------------------------------------------------------------
# FRONTEND (Next.js / Node)
# -----------------------------------------------------------------------------
**/node_modules/
**/.next/
**/.turbo/
**/.vercel/
**/out/
**/build/
**/*.tsbuildinfo
**/.swc/
**/.eslintcache
frontend/next-env.d.ts

# Reportes Lighthouse locales
lh-*.json
lh-report*.json
**/lh/

# E2E tests (herramienta interna, no se publica)
frontend/e2e/

# Scripts de build (output ya en public/fonts/, no necesarios en repo)
frontend/scripts/

# Playwright — salida de tests E2E
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/
frontend/e2e/.auth/

# -----------------------------------------------------------------------------
# DATOS SENSIBLES
# -----------------------------------------------------------------------------
backups/
*.sql
!supabase/migrations/*.sql
!supabase/functions/**/*.sql
*.gz
*.db
*.sqlite
*.sqlite3

# -----------------------------------------------------------------------------
# LOGS
# -----------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.sentry-debug.log

# -----------------------------------------------------------------------------
# IDE / SISTEMA OPERATIVO
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# HERRAMIENTAS INTERNAS / PROTOTIPOS / ARTEFACTOS PRIVADOS
# -----------------------------------------------------------------------------
.cursor/
.cursorignore
.cursorrules
.rtk/
.geo/
docs/

